{
  "expo": {
    "name": "CeFaci",
    "slug": "cefaci",
    "scheme": "cefaci",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icons/vara.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF1FB",
    "android": {
      "package": "ro.cefaci.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/vara-fg.png",
        "backgroundImage": "./assets/icons/vara-bg.png",
        "backgroundColor": "#0E1440"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "ro.cefaci.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E1440"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CeFaci folose\u0219te loca\u021bia doar c\u00e2nd ape\u0219i \u201eFolose\u0219te loca\u021bia mea\u201d, ca s\u0103-\u021bi arate locurile din apropiere."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CeFaci folose\u0219te camera doar c\u00e2nd faci poza bonului, ca s\u0103-\u021bi confirme ie\u0219irea.",
          "photosPermission": "CeFaci deschide pozele doar c\u00e2nd alegi poza unui bon.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD43B"
        }
      ],
      "./plugins/withSigning",
      "./plugins/withSeasonIcons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scaneaz\u0103 codul localului pentru sosirea grupului.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    }
  }
}
