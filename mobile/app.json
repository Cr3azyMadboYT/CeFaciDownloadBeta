{
  "expo": {
    "name": "CeFaci",
    "slug": "cefaci",
    "scheme": "cefaci",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./assets/icons/vara.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF1FB",
    "android": {
      "package": "ro.cefaci.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/vara-fg.png",
        "backgroundImage": "./assets/icons/vara-bg.png",
        "backgroundColor": "#0E1440"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "ro.cefaci.app",
      "supportsTablet": false,
      "buildNumber": "6",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E1440"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CeFaci folosește locația la cererea ta pentru locuri apropiate, revendicarea ofertelor și verificarea sosirii. La aceste verificări, coordonatele sunt trimise serverului."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CeFaci deschide camera când fotografiezi un bon, avatarul sau o problemă raportată.",
          "photosPermission": "CeFaci deschide pozele doar când alegi un bon sau atașezi o poză unei probleme.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD43B"
        }
      ],
      "./plugins/withSigning",
      "./plugins/withSeasonIcons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanează codul localului pentru sosirea grupului.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    }
  }
}
