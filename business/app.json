{
  "expo": {
    "name": "CeFaci Business",
    "slug": "cefaci-business",
    "version": "1.0.2",
    "orientation": "default",
    "scheme": "cefaci-business",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.cefaci.business",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "versionCode": 3
    },
    "ios": {
      "bundleIdentifier": "app.cefaci.business",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scanează biletul CeFaci al grupului."
      },
      "buildNumber": "3"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "CeFaci Business"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scanează biletul CeFaci al grupului.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "./plugins/withSigning"
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
